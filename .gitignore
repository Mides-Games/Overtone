__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
bench/audio/
# Corpus B's cached analyses and summaries (bench/corpus_b.py)
bench/.cache/

# Scoped so that .osu and .csv test fixtures can be committed (audit F-09):
# only ignore exports dropped at the repo root or in exports/.
/*.osu
/*.csv
/exports/
*.bak
*.part

# Rust (v4)
/target/
# Graphify's portable graph/report/HTML are checked in; local extraction cache
# and absolute-root marker are regenerated on each machine.
/graphify-out/cache/
/graphify-out/.graphify_analysis.json
/graphify-out/.graphify_root
/graphify-out/manifest.json
/graphify-out/project-status/graphify-out/cache/
/graphify-out/project-status/graphify-out/.graphify_analysis.json
/graphify-out/project-status/graphify-out/.graphify_root
/graphify-out/project-status/graphify-out/manifest.json
# Installer (installer/build.py): the frozen tree, the MSI and the ZIP, and
# PyInstaller's and WiX's working files. Build outputs are never committed.
/dist/
/build/
# Tauri frontend
/app/node_modules/
/app/dist/
# Website (site/): dependencies, builds and local secrets. `.env.example` is
# committed; a real `.env` never is.
/node_modules/
/site/*/node_modules/
/site/*/dist/
/site/*/.env
