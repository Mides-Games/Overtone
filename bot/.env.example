# The Overtone Discord bot (docs/bot.md). Copy to .env, which is never
# committed. With any of the first three empty the bot is OFF and says so.
DISCORD_TOKEN=
# The same value as site/api's BOT_TOKEN: 32+ characters, not WORKER_TOKEN.
BOT_TOKEN=
# site/api reached directly (http://127.0.0.1:3001 in development), never
# through overtone-web, which does not forward /api/internal.
OVERTONE_API=
BOT_POLL_MS=
BOT_DM_POLL_MS=
# scripts/register.mjs only.
DISCORD_APP_ID=
DISCORD_GUILD_ID=
