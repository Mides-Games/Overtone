<?xml version="1.0" encoding="utf-8"?>
<!--
  Overtone's MSI (roadmap 10.13.2), built by installer\build.py with WiX 5.0.2
  (MS-RL; installer\dotnet-tools.json pins it) from the tree PyInstaller made:

    dotnet tool run wix build Overtone.wxs -arch x64 -ext WixToolset.UI.wixext
      -d SourceDir=<dist\Overtone> -d Version=<4.0.0> -o <the .msi>

  Per user, without an administrator: Scope="perUser" leaves ALLUSERS empty
  and marks the package as needing no elevated privileges, and the program
  goes where Windows keeps per-user programs, %LOCALAPPDATA%\Programs.

  An uninstall removes what the MSI installed and nothing else: the program
  folder and the Start menu shortcut. Settings, the result cache, the write
  history, the library index and exports are written by the app at run time,
  outside the program folder (docs\11-msi-distribution.md, "User data
  locations"); the MSI never creates them and never deletes them.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="Overtone" Manufacturer="Overtone" Version="$(var.Version)"
           UpgradeCode="EE97BBEC-80EB-4D3C-BE6D-5963826D82CA"
           Scope="perUser" InstallerVersion="500" Compressed="yes">
    <SummaryInformation Description="Overtone: offline timing and hitsounding for osu!" />

    <!-- One upgrade code for the whole product family: a newer build replaces
         the installed one in place, a same-version rebuild too. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer Overtone is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- WixUI_InstallDir sets ARPNOMODIFY: one feature, nothing to modify. -->
    <Property Id="ARPPRODUCTICON" Value="OvertoneIcon" />
    <Icon Id="OvertoneIcon" SourceFile="$(var.SourceDir)\_internal\assets\logo.ico" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="UserProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Overtone" />
      </Directory>
    </StandardDirectory>

    <!-- The tree itself, ComponentGroup AppFiles, is generated by build.py
         (build\wix\files.wxs): one component per folder, holding its files,
         with an HKCU value as key path and a RemoveFolder, which is what
         Windows Installer asks of a per-user package (ICE38, ICE64) so that
         an uninstall takes every folder with it. -->

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut">
        <!-- The app claims this taskbar identity at start (overtone.py,
             APP_USER_MODEL_ID), so its window groups under the shortcut. -->
        <Shortcut Id="OvertoneShortcut" Name="Overtone"
                  Description="Timing and hitsounds for osu! beatmaps, offline"
                  Target="[INSTALLFOLDER]Overtone.exe" WorkingDirectory="INSTALLFOLDER"
                  Icon="OvertoneIcon">
          <ShortcutProperty Key="System.AppUserModel.ID" Value="Overtone.TimingWorkbench" />
        </Shortcut>
        <!-- The installer's own bookkeeping (the folder components' key paths
             are under it too), deleted whole on uninstall. The app keeps
             nothing in the registry. -->
        <RegistryKey Root="HKCU" Key="Software\Overtone\Installer" ForceDeleteOnUninstall="yes">
          <RegistryValue Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
        </RegistryKey>
        <!-- %LOCALAPPDATA%\Programs goes too if Overtone was all it held. -->
        <RemoveFolder Id="RemoveUserPrograms" Directory="UserProgramsFolder" On="uninstall" />
      </Component>
    </StandardDirectory>

    <Feature Id="Main" Title="Overtone">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <!-- Welcome, destination folder, install, finish. The licence page is
         skipped: the repository has no LICENSE file yet (README, "License"),
         and packaging the licences, Overtone's and the bundled libraries',
         is roadmap 10.13.3. -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UI>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg"
               Order="2" Condition="NOT Installed" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg"
               Order="2" />
    </UI>
  </Package>
</Wix>
