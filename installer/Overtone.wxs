<?xml version="1.0" encoding="utf-8"?>
<!--
  Overtone's MSI (roadmap 10.13.2), built by installer\build.py with WiX 5.0.2
  (MS-RL; installer\dotnet-tools.json pins it) from the tree PyInstaller made:

    dotnet tool run wix build Overtone.wxs -arch x64 -ext WixToolset.UI.wixext
      -d SourceDir=<dist\Overtone> -d Version=<0.1.0> -d LicenseRtf=<license.rtf>
      -o <the .msi>

  Per user, without an administrator: Scope="perUser" leaves ALLUSERS empty
  and marks the package as needing no elevated privileges, and the program
  goes where Windows keeps per-user programs, %LOCALAPPDATA%\Programs.

  An uninstall removes what the MSI installed and nothing else: the program
  folder and the Start menu shortcut. Settings, the result cache, the write
  history, the library index and exports are written by the app at run time,
  outside the program folder (docs\11-msi-distribution.md, "User data
  locations"); the MSI never creates them and never deletes them.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="Overtone" Manufacturer="Overtone" Version="$(var.Version)"
           UpgradeCode="EE97BBEC-80EB-4D3C-BE6D-5963826D82CA"
           Scope="perUser" InstallerVersion="500" Compressed="yes">
    <SummaryInformation Description="Overtone: offline timing and hitsounding for osu!" />

    <!-- One upgrade code for the whole product family: a newer build replaces
         the installed one in place, a same-version rebuild too. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer Overtone is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- WixUI_InstallDir sets ARPNOMODIFY: one feature, nothing to modify. -->
    <Property Id="ARPPRODUCTICON" Value="OvertoneIcon" />
    <Icon Id="OvertoneIcon" SourceFile="$(var.SourceDir)\_internal\assets\logo.ico" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="UserProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Overtone" />
      </Directory>
    </StandardDirectory>

    <!-- The tree itself, ComponentGroup AppFiles, is generated by build.py
         (build\wix\files.wxs): one component per folder, holding its files,
         with an HKCU value as key path and a RemoveFolder, which is what
         Windows Installer asks of a per-user package (ICE38, ICE64) so that
         an uninstall takes every folder with it. -->

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut">
        <!-- The app claims this taskbar identity at start (overtone.py,
             APP_USER_MODEL_ID), so its window groups under the shortcut. -->
        <Shortcut Id="OvertoneShortcut" Name="Overtone"
                  Description="Timing and hitsounds for osu! beatmaps, offline"
                  Target="[INSTALLFOLDER]Overtone.exe" WorkingDirectory="INSTALLFOLDER"
                  Icon="OvertoneIcon">
          <ShortcutProperty Key="System.AppUserModel.ID" Value="Overtone.TimingWorkbench" />
        </Shortcut>
        <!-- The installer's own bookkeeping (the folder components' key paths
             are under it too), deleted whole on uninstall. The app keeps
             nothing in the registry. -->
        <RegistryKey Root="HKCU" Key="Software\Overtone\Installer" ForceDeleteOnUninstall="yes">
          <RegistryValue Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
        </RegistryKey>
        <!-- %LOCALAPPDATA%\Programs goes too if Overtone was all it held. -->
        <RemoveFolder Id="RemoveUserPrograms" Directory="UserProgramsFolder" On="uninstall" />
      </Component>
    </StandardDirectory>

    <!-- .osz archives open with Overtone, which imports the set into Songs
         (overtone_web's import_osz: copied, never moved, never over a folder
         that already holds beatmaps). Per-user keys under HKCU\Software\Classes,
         which an uninstall takes with the component — nothing else is touched. -->
    <Component Id="OszAssociation" Directory="INSTALLFOLDER">
      <RegistryKey Root="HKCU" Key="Software\Classes\.osz">
        <RegistryValue Type="string" Value="Overtone.osz" KeyPath="yes" />
      </RegistryKey>
      <RegistryKey Root="HKCU" Key="Software\Classes\Overtone.osz">
        <RegistryValue Type="string" Value="osu! beatmap archive (Overtone)" />
      </RegistryKey>
      <RegistryKey Root="HKCU" Key="Software\Classes\Overtone.osz\DefaultIcon">
        <RegistryValue Type="string" Value="[INSTALLFOLDER]Overtone.exe,0" />
      </RegistryKey>
      <RegistryKey Root="HKCU" Key="Software\Classes\Overtone.osz\shell\open\command">
        <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]Overtone.exe&quot; &quot;%1&quot;" />
      </RegistryKey>
    </Component>

    <Feature Id="Main" Title="Overtone" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <!-- Chosen on the setup screen's feature tree, or left out. Levels are
         the stock mechanism: 1 installs, 1000 sits above INSTALLLEVEL's 100
         until picked in the tree or named in ADDLOCAL. No bespoke conditions,
         no custom XML — WiX's own tree, translated and tested by WiX. -->
    <Feature Id="OszAssoc" Title=".osz beatmap archives" Level="1">
      <ComponentRef Id="OszAssociation" />
    </Feature>
    <Feature Id="AudioAssoc" Title="Audio analysis" Level="1000">
      <ComponentRef Id="AudioAssociation" />
    </Feature>
    <Feature Id="DesktopIcon" Title="Desktop shortcut" Level="1000">
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <!-- The associations the tree offers. Audio files stay untouched unless
         asked: grabbing someone's music player default is not a default. -->
    <Component Id="AudioAssociation" Directory="INSTALLFOLDER">
      <RegistryKey Root="HKCU" Key="Software\Classes\Overtone.audio">
        <RegistryValue Type="string" Value="Audio analysed with Overtone" KeyPath="yes" />
      </RegistryKey>
      <RegistryKey Root="HKCU" Key="Software\Classes\Overtone.audio\shell\analyze\command">
        <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]Overtone.exe&quot; &quot;%1&quot;" />
      </RegistryKey>
      <RegistryKey Root="HKCU" Key="Software\Classes\.mp3">
        <RegistryValue Type="string" Value="Overtone.audio" />
      </RegistryKey>
      <RegistryKey Root="HKCU" Key="Software\Classes\.ogg">
        <RegistryValue Type="string" Value="Overtone.audio" />
      </RegistryKey>
      <RegistryKey Root="HKCU" Key="Software\Classes\.flac">
        <RegistryValue Type="string" Value="Overtone.audio" />
      </RegistryKey>
      <RegistryKey Root="HKCU" Key="Software\Classes\.wav">
        <RegistryValue Type="string" Value="Overtone.audio" />
      </RegistryKey>
      <RegistryKey Root="HKCU" Key="Software\Classes\.m4a">
        <RegistryValue Type="string" Value="Overtone.audio" />
      </RegistryKey>
    </Component>

    <!-- A desktop icon, only when asked. -->
    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut" Directory="DesktopFolder">
        <Shortcut Id="OvertoneDesktop" Name="Overtone"
                  Description="Timing and hitsounds for osu! beatmaps, offline"
                  Target="[INSTALLFOLDER]Overtone.exe" WorkingDirectory="INSTALLFOLDER"
                  Icon="OvertoneIcon">
          <ShortcutProperty Key="System.AppUserModel.ID" Value="Overtone.TimingWorkbench" />
        </Shortcut>
        <RegistryKey Root="HKCU" Key="Software\Overtone\Installer">
          <RegistryValue Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
        </RegistryKey>
      </Component>
    </StandardDirectory>

    <!-- Welcome, licence, setup type, tree, destination folder, install,
         finish: WixUI_FeatureTree's own order. Typical installs Main and the
         .osz association; Complete takes all four; Custom picks in the tree.
         The licence page shows Overtone's MIT,
         which build.py renders to RTF from the repository's LICENSE, so the two
         cannot drift. The bundled libraries' notices are far too long for a
         dialog and ship as files instead: LICENSE.txt and
         THIRD-PARTY-NOTICES.txt in the program folder, written by
         installer\notices.py. -->
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
    <ui:WixUI Id="WixUI_FeatureTree" InstallDirectory="INSTALLFOLDER" />
  </Package>
</Wix>
