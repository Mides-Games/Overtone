# Copy to .env and fill in. Names only: no value here is a real secret.
# docs/site.md explains each one; `pnpm dev` needs none of them.
PORT=
HOST=
NODE_ENV=
TRUST_PROXY=
DATABASE_URL=
SITE_URL=
SESSION_SECRET=
SESSION_DAYS=
MIDES_CLIENT_SECRET=
MIDES_AUTH_URL=
MIDES_WEB_URL=
MIDES_IMAGE_ORIGINS=
MIDES_APP=overtone
MIDES_DEV_LOGIN=
ANON_DAILY_LIMIT=
USER_DAILY_LIMIT=
ANON_MAX_PENDING=
USER_MAX_PENDING=
QUEUE_MAX=
CACHE_DAILY_LIMIT=
MAX_AUDIO_SECONDS=
MAX_UPLOAD_MB=
SPOOL_DIR=
SPOOL_MAX_MB=
SPOOL_MIN_FREE_MB=
WORKER_TOKEN=
JOB_TIMEOUT_S=
PROXY_SECRET=
# W9 (docs/bot.md): each is off while unset, and the API says so at start.
BOT_TOKEN=
MIDES_DISCORD_LINK_PATH=
OSU_CLIENT_ID=
OSU_CLIENT_SECRET=
OSU_REDIRECT_URI=
OSU_PKCE=
# `pnpm dev` only: the worker it starts (worker/main.py). It always points the
# worker at this API and hands it WORKER_TOKEN; a worker run on its own reads
# OVERTONE_API, WORKER_TOKEN and WORKER_POLL_S from its own environment.
WORKER_POLL_S=
OVERTONE_PYTHON=
OVERTONE_WORKER=
